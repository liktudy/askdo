{
  "crew": {
    "id": "feedback-triage-crew",
    "name": "Feedback Triage Crew",
    "purpose": "Classify feedback into themes, priority, and actions."
  },
  "roles": [
    {
      "id": "feedback-analyst",
      "name": "Feedback Analyst",
      "archetype": "feedback-normalizer",
      "accountability": "Normalize raw feedback into discrete items.",
      "boundary": "Does not expose private data or invent feedback.",
      "default_permission": "L0 Observer",
      "acceptance_checks": ["Feedback items are distinct.", "Sensitive details are avoided."],
      "scenario_bindings": [{"scenario": "medium-feedback-triage", "responsibility_adjustment": "Prepare feedback for theme analysis.", "permission_adjustment": "none"}]
    },
    {
      "id": "theme-strategist",
      "name": "Theme Strategist",
      "archetype": "theme-clustering-specialist",
      "accountability": "Group feedback by theme and user impact.",
      "boundary": "Owns theme structure only.",
      "default_permission": "L0 Observer",
      "acceptance_checks": ["Themes are meaningful.", "Items map to themes."],
      "scenario_bindings": [{"scenario": "theme-clustering", "responsibility_adjustment": "Cluster feedback into action-ready themes.", "permission_adjustment": "none"}]
    },
    {
      "id": "priority-reviewer",
      "name": "Priority Reviewer",
      "archetype": "severity-and-frequency-scorer",
      "accountability": "Score severity, frequency, and recommended priority.",
      "boundary": "Does not promise implementation.",
      "default_permission": "L0 Observer",
      "acceptance_checks": ["Priority rationale is explicit.", "High-risk items are escalated."],
      "scenario_bindings": [{"scenario": "priority-scoring", "responsibility_adjustment": "Score each theme and action.", "permission_adjustment": "none"}]
    },
    {
      "id": "triage-producer",
      "name": "Triage Producer",
      "archetype": "report-and-csv-producer",
      "accountability": "Produce the triage report and action table.",
      "boundary": "Formats reviewed analysis without changing conclusions.",
      "default_permission": "L3 Executor",
      "acceptance_checks": ["Report is saved.", "CSV is saved.", "Actions are readable."],
      "scenario_bindings": [{"scenario": "triage-delivery", "responsibility_adjustment": "Save FEEDBACK_TRIAGE.md and ACTION_TABLE.csv.", "permission_adjustment": "none"}]
    }
  ]
}
