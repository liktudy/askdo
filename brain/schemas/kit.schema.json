{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Askdo Kit",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "status", "purpose", "entry_file", "flow_file", "mates_file", "roles_file", "roster_file", "approval", "build_approval", "performance"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "under_review", "merge_candidate", "closure_candidate", "closed", "archived"]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["why", "success_looks_like", "constraints", "out_of_scope"],
      "properties": {
        "why": {
          "type": "string",
          "minLength": 1
        },
        "success_looks_like": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "out_of_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entry_file": {
      "type": "string",
      "const": "ENTRY.md"
    },
    "flow_file": {
      "type": "string",
      "const": "FLOW.md"
    },
    "mates_file": {
      "type": "string",
      "const": "MATES.md"
    },
    "roles_file": {
      "type": "string",
      "const": "ROLES.json"
    },
    "roster_file": {
      "type": "string",
      "const": "ROSTER.json"
    },
    "source_root": {
      "type": "string"
    },
    "run_root": {
      "type": "string"
    },
    "deliverable_root": {
      "type": "string"
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 2 },
        "deliverable_default": { "type": "string", "minLength": 2 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "risk_level"],
      "properties": {
        "required": { "type": "boolean" },
        "risk_level": {
          "type": "string",
          "enum": ["low", "normal", "high", "critical"]
        }
      }
    },
    "build_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "approved_at"],
      "properties": {
        "required": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "not_required"]
        },
        "approved_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_count", "success_count", "failure_count", "last_run_at"],
      "properties": {
        "run_count": { "type": "integer", "minimum": 0 },
        "success_count": { "type": "integer", "minimum": 0 },
        "failure_count": { "type": "integer", "minimum": 0 },
        "review_failure_count": { "type": "integer", "minimum": 0 },
        "reuse_count": { "type": "integer", "minimum": 0 },
        "delivery_count": { "type": "integer", "minimum": 0 },
        "level_note_count": { "type": "integer", "minimum": 0 },
        "last_run_at": { "type": ["string", "null"], "format": "date-time" },
        "last_success_at": { "type": ["string", "null"], "format": "date-time" },
        "last_audit_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maturity": {
          "type": "string",
          "enum": ["draft", "reviewed", "active", "stable", "mature", "needs_refactor"]
        },
        "last_audit_verdict": {
          "type": ["string", "null"],
          "enum": ["pass", "pass_with_level_notes", "revise_before_run", "reject_or_rebuild", null]
        },
        "last_audit_at": { "type": ["string", "null"], "format": "date-time" },
        "level_note_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
