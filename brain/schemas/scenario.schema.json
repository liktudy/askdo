{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Askdo Scenario Option",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "name",
    "planning_frame",
    "outcome",
    "inputs_or_assumptions",
    "planning_decisions_applied",
    "kit_path",
    "expected_artifacts",
    "feasibility",
    "risk_notes",
    "closure_logic"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "planning_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "scope",
        "audience",
        "artifact_type",
        "success_criteria",
        "closure_logic"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "source_inputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_tolerance": {
          "type": "string",
          "minLength": 1
        },
        "execution_depth": {
          "type": "string",
          "minLength": 1
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "closure_logic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "inputs_or_assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "planning_decisions_applied": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "kit_path": {
      "type": "string",
      "enum": ["reuse_existing_kit", "build_new_kit", "revise_existing_kit"]
    },
    "target_kit_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "feasibility": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "risk_notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "closure_logic": {
      "type": "string",
      "minLength": 1
    },
    "recommended": {
      "type": "boolean"
    }
  }
}
