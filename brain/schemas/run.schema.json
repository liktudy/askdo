{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Askdo Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "kit_id", "ask", "status", "started_at", "updated_at"],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kit_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "ask": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "blocked", "failed", "completed"]
    },
    "result_path": {
      "type": ["string", "null"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

