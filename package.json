{
  "name": "askdo",
  "version": "0.1.5",
  "type": "module",
  "description": "Askdo turns a user ask into a reusable business loop with executable multi-agent flow.",
  "main": "platforms/opencode/.opencode/plugins/askdo.js",
  "scripts": {
    "check": "node scripts/check.js",
    "check:json": "node scripts/check-json.js",
    "check:assets": "node scripts/check-assets.js",
    "check:assets:strict": "node scripts/check-assets.js --strict",
    "check:version": "node scripts/check-version-bump.js",
    "manifests:generate": "node scripts/generate-manifests.js",
    "manifests:check": "node scripts/generate-manifests.js --check",
    "release:patch": "node scripts/release-version.js patch",
    "release:minor": "node scripts/release-version.js minor",
    "release:major": "node scripts/release-version.js major",
    "smoke:opencode": "node scripts/smoke-opencode.js"
  },
  "keywords": [
    "opencode-plugin",
    "business",
    "multi-agent",
    "workflow",
    "kits"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.15.13"
  },
  "license": "UNLICENSED",
  "private": true
}
